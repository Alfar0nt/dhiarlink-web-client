# Dhiarlink Web Client — Production Config
# Copy to .env:  cp .env.example .env

DHIARLINK_SERVER_URL=https://www.dhiarr.qzz.io
DHIARLINK_SERVER_API_KEY=
DHIARLINK_SERVER_NAME=Dhiarlink
DHIARLINK_SERVER_FORWARD_CREDENTIALS=false

# Docker network (Caddy and other containers are on this network)
DOCKER_NETWORK=dhiarlink_dhiarlink_internal
